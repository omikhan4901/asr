# ── Data — never commit audio or large generated artifacts ────────────────
/data/
*.wav
*.mp3
*.mp4
*.mov
*.mkv
*.jsonl              # nbest_candidates files are large and fully regeneratable
*checkpoint*.json    # resumability checkpoints — regeneratable, run-specific
dataset_stats.txt    # regenerated by preprocess_chunk_align.py each run

# Large/generated CSVs specifically (keep small example/schema CSVs if you add any)
aligned_chunks.csv
chunks_manifest*.csv
train_split.csv
eval_split.csv
eval_split_clean.csv

# Web demo runtime data (local_server.py's stand-in for the Modal volume)
web/backend/local_data/

# ── Secrets — Modal tokens, API keys, env config ───────────────────────────
.env
.env.*
*.env
.modal.toml           # if it ever ends up inside the repo directory — Modal
                       # normally stores this in ~/.modal.toml, outside any
                       # repo, but ignore defensively in case that changes
secrets/

# ── Model / HF cache (if ever pointed at a local dir instead of ~/.cache) ──
models/
!src/bangla_asr/models/
!src/bangla_asr/models/**
*.ckpt
*.bin
*.safetensors
.cache/
.Lib/
Lib

# ── Figures — keep the generator scripts, not necessarily every render ────
# Uncomment if you don't want regenerated PDFs/PNGs cluttering diffs:
# figures/*.pdf
# figures/*.png

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.venv/
venv/
env/
pyvenv.cfg
.ipynb_checkpoints/
# The repo root doubles as a Windows venv; keep its folders out of git.
/Include/
/Scripts/
/share/
/etc/

# ── Node / frontend tooling (if you add a build step later) ───────────────
node_modules/
.vercel/
dist/
.next/

# ── Editor / OS noise ────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db


# Run outputs
logs/
results/
spotcheck/

# Team labeling kits (contain dataset excerpts)
labeling_kit/
